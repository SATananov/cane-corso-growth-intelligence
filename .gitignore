__pycache__/
.ipynb_checkpoints/
.env
.venv/
venv/
*.pyc
*.log
.DS_Store

# Raw external datasets
data/raw/*.zip
data/raw/*.csv
data/raw/*.xlsx
data/raw/*.parquet

# Keep raw data notes, but do not commit downloaded raw datasets
!data/raw/source_notes.md
!data/raw/.gitkeep

# Raw external metadata files
data/raw/*.txt
!data/raw/source_notes.md

# Local image datasets for Computer Vision experiments
# These folders may contain downloaded public datasets or consent-based owner images.
# They must stay local and must not be committed to GitHub.
data/images/local_dataset/*
!data/images/local_dataset/.gitignore
!data/images/local_dataset/README.md
data/images/local_only/
*.jpg
*.jpeg
*.png
*.webp
*.bmp
*.tif
*.tiff
